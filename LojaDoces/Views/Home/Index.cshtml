@{
    ViewData["Title"] = "Loja de Doces";
}

<div class="text-center py-5">
    <h1 class="display-4">🍬 Loja de Doces</h1>
    <p class="lead">Gerencie categorias, clientes, fornecedores e pedidos em um só lugar.</p>
</div>

<div class="row g-4 justify-content-center">
    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title">Categorias</h5>
                    <p class="card-text">Organize os tipos de doces da loja.</p>
                </div>
                <a asp-controller="Categorias" asp-action="Index" class="btn btn-primary mt-3">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title">Clientes</h5>
                    <p class="card-text">Cadastre e consulte seus clientes.</p>
                </div>
                <a asp-controller="Clientes" asp-action="Index" class="btn btn-primary mt-3">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title">Fornecedores</h5>
                    <p class="card-text">Controle quem abastece a loja.</p>
                </div>
                <a asp-controller="Fornecedores" asp-action="Index" class="btn btn-primary mt-3">Acessar</a>
            </div>
        </div>
    </div>

    <div class="col-md-3">
        <div class="card h-100 text-center shadow-sm">
            <div class="card-body d-flex flex-column justify-content-between">
                <div>
                    <h5 class="card-title">Pedidos</h5>
                    <p class="card-text">Registre e acompanhe as vendas.</p>
                </div>
                <a asp-controller="Pedidos" asp-action="Index" class="btn btn-primary mt-3">Acessar</a>
            </div>
        </div>
    </div>
</div>