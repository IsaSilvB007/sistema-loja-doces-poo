@model IEnumerable<LojaDoces.ViewModels.CategoriaViewModel>
@{ ViewData["Title"] = "Categorias"; }

<h1>Categorias</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Nova categoria</a>

<table class="table table-striped">
    <thead>
        <tr><th>Nome</th><th>Ativa</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var c in Model)
    {
        <tr>
            <td>@c.Nome</td>
            <td>@(c.Ativa ? "Sim" : "Não")</td>
            <td>
                <a asp-action="Details" asp-route-id="@c.Id">Detalhes</a> |
                <a asp-action="Edit" asp-route-id="@c.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@c.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>