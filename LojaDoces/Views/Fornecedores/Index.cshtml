@model IEnumerable<LojaDoces.ViewModels.FornecedorViewModel>
@{ ViewData["Title"] = "Fornecedores"; }

<h1>Fornecedores</h1>
<a asp-action="Create" class="btn btn-primary mb-3">Novo fornecedor</a>

<table class="table table-striped">
    <thead>
        <tr><th>Nome</th><th>CNPJ</th><th>E-mail</th><th>Telefone</th><th>Ativo</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var f in Model)
    {
        <tr>
            <td>@f.Nome</td>
            <td>@f.Cnpj</td>
            <td>@f.Email</td>
            <td>@f.Telefone</td>
            <td>@(f.Ativo ? "Sim" : "Não")</td>
            <td>
                <a asp-action="Details" asp-route-id="@f.Id">Detalhes</a> |
                <a asp-action="Edit" asp-route-id="@f.Id">Editar</a> |
                <a asp-action="Delete" asp-route-id="@f.Id">Excluir</a>
            </td>
        </tr>
    }
    </tbody>
</table>