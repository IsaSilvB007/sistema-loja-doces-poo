@model LojaDoces.ViewModels.FornecedorViewModel
@{ ViewData["Title"] = "Detalhes do fornecedor"; }

<h1>Detalhes do fornecedor</h1>
<dl class="row">
    <dt class="col-sm-2">Nome</dt><dd class="col-sm-10">@Model.Nome</dd>
    <dt class="col-sm-2">CNPJ</dt><dd class="col-sm-10">@Model.Cnpj</dd>
    <dt class="col-sm-2">E-mail</dt><dd class="col-sm-10">@Model.Email</dd>
    <dt class="col-sm-2">Telefone</dt><dd class="col-sm-10">@Model.Telefone</dd>
    <dt class="col-sm-2">Ativo</dt><dd class="col-sm-10">@(Model.Ativo ? "Sim" : "Não")</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-primary">Editar</a>
<a asp-action="Index" class="btn btn-secondary">Voltar</a>