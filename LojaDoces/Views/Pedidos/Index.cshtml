@model IEnumerable<LojaDoces.Models.ViewModels.PedidoListaViewModel>
@{ ViewData["Title"] = "Pedidos"; }

<h2>Pedidos</h2>
<a asp-action="Criar" class="btn btn-primary mb-3">Novo pedido</a>

<table class="table table-striped">
    <thead>
        <tr><th>#</th><th>Cliente</th><th>Data</th><th>Status</th><th>Total</th><th></th></tr>
    </thead>
    <tbody>
    @foreach (var p in Model)
    {
        <tr>
            <td>@p.Id</td>
            <td>@p.ClienteNome</td>
            <td>@p.DataCriacao.ToString("dd/MM/yyyy HH:mm")</td>
            <td>@p.Status</td>
            <td>@p.Total.ToString("C")</td>
            <td><a asp-action="Detalhes" asp-route-id="@p.Id" class="btn btn-sm btn-outline-primary">Abrir</a></td>
        </tr>
    }
    </tbody>
</table>